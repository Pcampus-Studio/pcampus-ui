{
  "name": "@pcampus-studio/ui",
  "version": "1.4.3",
  "description": "Shared component library and design system for the Pcampus ecosystem",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./dist/esm/tokens/index.css": "./dist/esm/tokens/index.css",
    "./dist/index.css": "./dist/index.css",
    "./dist/theme.css": "./dist/theme.css",
    "./dist/motion.css": "./dist/motion.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:css": "tailwindcss -i src/styles/components.css -o dist/index.css --minify && node scripts/build-theme.cjs && tailwindcss -i src/motion/keyframes.css -o dist/motion.css --minify",
    "build": "tsup && node scripts/stamp-use-client.cjs && npm run build:css",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "motion": ">=11",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/addon-links": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.12",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.28",
    "clsx": "^2.1.1",
    "focus-trap-react": "^10.3.1",
    "lucide-react": "^0.469.0",
    "recharts": "^2.12.7"
  }
}
